@inject IAdminUserService AdminUserService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2">Neues Passwort eingeben:</MudText>
        <MudTextField T="string"
                      @bind-Value="_newPassword"
                      Label="Neues Passwort" 
                      InputType="InputType.Password"
                      Required="true"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ChangePasswordAsync">Passwort ändern</MudButton>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; }
    
    [Parameter] public Guid AdminId { get; set; }
    
    private string _newPassword = string.Empty;
    
    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            return;
        }

        try
        {
            await AdminUserService.ChangePasswordAsync(AdminId, _newPassword);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch
        {
            MudDialog.Close(DialogResult.Ok(false));
        }
        
        
        
    }
    
    private void Cancel() => MudDialog.Cancel();
}
