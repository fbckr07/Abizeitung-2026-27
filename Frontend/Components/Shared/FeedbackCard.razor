
@inject ISnackbar Snackbar
@inject IFeedbackService FeedbackService

<MudItem xs="12" md="6">
    <MudCard Elevation="2" Class="h-100">
        <MudCardHeader>
            <MudText Typo="Typo.h6">@Feedback.SentBy</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.body1">@Feedback.Text</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="Accept">Annehmen</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Decline">Ablehnen</MudButton>
        </MudCardActions>
    </MudCard>
</MudItem>


@code
{
    [Parameter]
    public required Feedback Feedback { get; set; }
    
    [Parameter]
    public required Action OnChangedCallback { get; set; }

    private async Task Accept()
    {
        var result = await FeedbackService.AcceptFeedbackAsync(Feedback.Id);
        OnChangedCallback();
        if (result)
        {
            Snackbar.Add("Feedback angenommen", Severity.Success);
        }
        else
        {
            Snackbar.Add("Feedback abgelehnt", Severity.Error);
        }
    }
    
    private async Task Decline()
    {
        var result = await FeedbackService.RejectFeedbackAsync(Feedback.Id);
        OnChangedCallback();
        if (result)
        {
            Snackbar.Add("Feedback abgelehnt", Severity.Success);
        }
        else
        {
            Snackbar.Add("Fehler beim Ablehnen des Feedbacks", Severity.Error);
        }
    }
}
