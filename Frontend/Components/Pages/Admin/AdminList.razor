@page "/admin/admins"
@using Frontend.Data.DTOs
@attribute [Authorize(Policy = Permissions.AdminList)]
@layout AdminLayout
@inject IAdminUserService AdminUserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Admins</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Admins</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">Neuen Admin erstellen</MudText>
    <MudGrid>
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_newUsername"
                          Label="Benutzername"
                          Required="true"
                          Immediate="true"
                          MaxLength="100"
                          Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_newPassword"
                          Label="Passwort"
                          Required="true"
                          Immediate="true"
                          MaxLength="200"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="_saved"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="CreateAdminAsync">
                Erstellen
            </MudButton>
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
        Das Passwort muss mindestens 8 Zeichen enthalten.
    </MudText>
</MudPaper>

<MudTable Items="_admins" Hover="true" Loading="_admins is null" Elevation="1">
    <HeaderContent>
        <MudTh>Benutzername</MudTh>
        <MudTh>Rechte</MudTh>
        <MudTh></MudTh>
        <MudTh>Passwort</MudTh>
        <MudTh>Aktionen</MudTh>
    </HeaderContent>
    <RowTemplate>
        @if (_editingAdmin is not null && _editingAdmin.Id == context.Id)
        {
            <MudTd DataLabel="Benutzername">@context.Username</MudTd>
            <MudTd DataLabel="Rechte">
                @foreach (var (wert, permission) in Permissions.AdminPermissions)
                {
                    <MudCheckBox T="bool"
                                 Value="_editingAdmin.Permissions.Contains(wert)"
                                 ValueChanged="@(_checked => TogglePermission(wert, _checked))"
                                 Label="@permission"
                                 Dense="true"/>
                }
            </MudTd>
            <MudTd>
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="@(() => DeleteAdminAsync(@context.Id))">
                    Löschen
                </MudButton>
            </MudTd>
            <MudTd DataLabel="Passwort">
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Lock"
                           OnClick="@(() => ChangePasswordAsync(@context.Id))">
                    Ändern
                </MudButton>
            </MudTd>
            <MudTd DataLabel="Aktionen">
                <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="SaveAsync" />
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _editingAdmin = null)" />
            </MudTd>
        }
        else
        {
            <MudTd DataLabel="Benutzername">@context.Username</MudTd>
            <MudTd DataLabel="Rechte">
                @if (context.Permissions.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Keine</MudText>
                }
                else
                {
                    @foreach (var permission in context.Permissions)
                    {
                        <MudChip T="string" Size="Size.Small" Class="mr-1">@ToDisplayName(permission)</MudChip>
                    }
                }
            </MudTd>
            <MudTd>
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="@(() => DeleteAdminAsync(@context.Id))">
                    Löschen
                </MudButton>
            </MudTd>
            <MudTd DataLabel="Passwort">
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Lock"
                           OnClick="@(() => ChangePasswordAsync(@context.Id))">
                    Ändern
                </MudButton>
            </MudTd>
            <MudTd DataLabel="Aktionen">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => BeginEdit(context))" />
            </MudTd>
        }
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4">Keine Admins vorhanden.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private IReadOnlyList<AdminUserDto>? _admins;
    private string _newUsername = string.Empty;
    private string _newPassword = string.Empty;
    private bool _saved;
    private EditingModel? _editingAdmin;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _admins = await AdminUserService.GetAllAsync();
    }

    private async Task CreateAdminAsync()
    {
        _saved = true;
        try
        {
            await AdminUserService.CreateAsync(_newUsername, _newPassword);
            _newUsername = string.Empty;
            _newPassword = string.Empty;
            await LoadAsync();
            Snackbar.Add("Admin erfolgreich erstellt.", Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saved = false;
        }
    }

    private async Task DeleteAdminAsync(Guid adminId)
    {
        try
        {
            await AdminUserService.DeleteAsync(adminId);
        }
        catch (ArgumentException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        catch (InvalidOperationException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            await LoadAsync();
        }
    }

    private sealed class EditingModel
    {
        public Guid Id { get; set; }
        public List<string> Permissions { get; set; } = new();
    }

    private async Task TogglePermission(string permission, bool active)
    {
        if (_editingAdmin is null)
            return;
        
        if (active && !_editingAdmin.Permissions.Contains(permission))
        {
            _editingAdmin.Permissions.Add(permission);
        }
        else if (!active)
        {
            _editingAdmin.Permissions.Remove(permission);
        }
    }

    private string ToDisplayName(string permission) =>
        Permissions.AdminPermissions.FirstOrDefault(r => r.Value == permission).DisplayName ?? permission;
        

    private void BeginEdit(AdminUserDto admin)
    {
        _editingAdmin = new EditingModel
        {
            Id = admin.Id,
            Permissions = admin.Permissions.ToList()
        };
    }

    private async Task SaveAsync()
    {
        if (_editingAdmin is null)
            return;
        
        await AdminUserService.SetPermissionAsync(_editingAdmin.Id, _editingAdmin.Permissions);
        _editingAdmin = null;
        await LoadAsync();
        Snackbar.Add("Rechte erfolgreich aktualisiert.", Severity.Success);
    }
    
    private async Task ChangePasswordAsync(Guid adminId)
    {
        var parameters = new DialogParameters
        {
            [nameof(ChangePasswordDialog.AdminId)] = adminId
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ChangePasswordDialog>("Passwort ändern", parameters, options);
        var result = await dialog.Result;
        
        if (!result?.Canceled ?? false)
        {
            Snackbar.Add("Passwort erfolgreich geändert.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Passwortänderung abgebrochen.", Severity.Info);
        }
    }
}