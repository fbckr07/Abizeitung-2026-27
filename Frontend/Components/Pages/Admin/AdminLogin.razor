@page "/admin/login"
@layout LoginLayout
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Admin-Login</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="8" md="5" lg="4">
        <MudPaper Class="pa-6" Elevation="2">
            <MudText Typo="Typo.h4" GutterBottom="true">Admin-Login</MudText>

            @if (_isLockedOut)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                    @AuthRateLimiting.FormatDuration(AuthRateLimiting.Lockout) Minuten gesperrt.
                </MudAlert>
            }
            else
            {
                @if (Error == "invalid")
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">
                        Benutzername oder Passwort falsch.
                    </MudAlert>
                }

                <form method="post" action="/admin/auth/login">
                    @if (!string.IsNullOrEmpty(ReturnUrl))
                    {
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    }
                    <MudTextField @bind-Value="_username"
                                  Label="Benutzername"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  AutoFocus="true"
                                  Disabled="_isLockedOut"
                                  Class="mb-4"
                                  @attributes="_usernameFieldAttributes" />
                    <MudTextField @bind-Value="_password"
                                  Label="Passwort"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Disabled="_isLockedOut"
                                  Class="mb-4"
                                  @attributes="_passwordFieldAttributes" />
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="_isLockedOut">
                        Anmelden
                    </MudButton>
                </form>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string? Error { get; set; }
    private string? ReturnUrl { get; set; }

    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _isLockedOut;

    private static readonly Dictionary<string, object> _usernameFieldAttributes = new()
    {
        ["name"] = "username",
        ["autocomplete"] = "username"
    };

    private static readonly Dictionary<string, object> _passwordFieldAttributes = new()
    {
        ["name"] = "password",
        ["autocomplete"] = "current-password"
    };

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        var redirectState = httpContext is null
            ? null
            : AuthRateLimiting.GetRedirectState(httpContext, true);
        Error = redirectState?.Error;
        ReturnUrl = redirectState?.ReturnUrl;
        _isLockedOut = Error == "locked"
            || (httpContext is not null && AuthRateLimiting.HasAdminLockoutCookie(httpContext));
    }
}
