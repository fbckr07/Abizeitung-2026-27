@page "/admin/lehrerzitate"
@using Frontend.Data.DTOs
@attribute [Authorize(Policy = Permissions.AdminLehrerzitate)]
@layout AdminLayout
@inject IModerationService ModerationService
@inject ISnackbar Snackbar

<PageTitle>Lehrerzitate</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Lehrerzitate</MudText>

@if (_quotes is null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
}
else if (_quotes.Count == 0)
{
    <MudAlert Severity="Severity.Info">Keine offenen Lehrerzitate.</MudAlert>
}
else
{
    @foreach (var zitat in _quotes)
    {
        <MudCard Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1">@zitat.TeacherName</MudText>
                <MudText Typo="Typo.body1">„@zitat.Quote"</MudText>
                @if (!string.IsNullOrWhiteSpace(zitat.Context))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@zitat.Context</MudText>
                }
                <MudStack Row="true" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               OnClick="@(() => FreigebenZitatAsync(zitat.Id))">
                        Freigeben
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="@(() => AblehnenZitatAsync(zitat.Id))">
                        Ablehnen
                    </MudButton>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }
}

@code {
    private IReadOnlyList<OpenProfileDto>? _profiles;
    private IReadOnlyList<OpenQuoteDto>? _quotes;
    private readonly Dictionary<Guid, string> _comments = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _quotes = await ModerationService.GetOpenQuotesAsync();
    }

    private string GetKommentar(Guid profilId)
    {
        return _comments.GetValueOrDefault(profilId, string.Empty);
    }

    private void SetKommentar(Guid profilId, string value)
    {
        _comments[profilId] = value;
    }

    private async Task FreigebenZitatAsync(Guid id)
    {
        await ModerationService.AcceptQuoteAsync(id);
        Snackbar.Add("Zitat freigegeben.", Severity.Success);
        await LoadAsync();
    }

    private async Task AblehnenZitatAsync(Guid id)
    {
        await ModerationService.DenyQuoteAsync(id);
        Snackbar.Add("Zitat abgelehnt.", Severity.Info);
        await LoadAsync();
    }

}
