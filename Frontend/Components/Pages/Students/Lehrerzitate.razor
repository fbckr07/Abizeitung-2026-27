@page "/lehrerzitate"
@attribute [Authorize(Policy = Permissions.Lehrerzitate)]
@using System.Security.Claims
@using Frontend.Data.Enums
@using Frontend.Data.Records
@inject ITeacherQuoteService TeacherQuoteService
@inject ITeacherQuoteLikeService LikeService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<PageTitle>Lehrerzitate</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Lehrerzitate</MudText>

<MudPaper Class="pa-4 mb-6" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">Zitat einreichen</MudText>

    @if (_sentSuccessful)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">Zitat wird geprüft.</MudAlert>
    }

    <MudForm @ref="_form" Model="_model">
        <MudAutocomplete T="CandidateDto" Label="Lehrer" @bind-Value="_selectedTeacher"
                          SearchFunc="SearchTeacherAsync" ToStringFunc="@(l => l?.Name)"
                          Required="true" RequiredError="Lehrer auswählen."
                          Class="mb-4" />

        <MudTextField @bind-Value="_model.Quote" Label="Zitat" Lines="3" MaxLength="500"
                      Counter="500" Required="true" RequiredError="Zitat eingeben."
                      Class="mb-4" />

        <MudTextField @bind-Value="_model.Context" Label="Kontext (optional)" Class="mb-4" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_sending">
            Einreichen
        </MudButton>
    </MudForm>
</MudPaper>

<MudText Typo="Typo.h6" GutterBottom="true">Alle freigegebenen Zitate</MudText>

<MudButtonGroup Class="mb-4" Color="Color.Primary" Variant="Variant.Outlined">
    <MudButton OnClick="@(() => SetSortModeAsync(TeacherQuoteSortMode.Default))"
               Variant="@(_sortMode == TeacherQuoteSortMode.Default ? Variant.Filled : Variant.Outlined)">
        Nach Lehrer
    </MudButton>
    <MudButton OnClick="@(() => SetSortModeAsync(TeacherQuoteSortMode.CreatedAtDesc))"
               Variant="@(_sortMode == TeacherQuoteSortMode.CreatedAtDesc ? Variant.Filled : Variant.Outlined)">
        Nach Datum
    </MudButton>
</MudButtonGroup>

<MudTable T="TeacherQuoteDto" ServerData="ServerReloadAsync" @ref="_table" Hover="false" Elevation="0"
          GroupBy="@(_sortMode == TeacherQuoteSortMode.Default ? _groups : null)"
          GroupHeaderStyle="background-color:var(--mud-palette-background-gray)">
    <ColGroup>
        <col />
    </ColGroup>
    <GroupHeaderTemplate>
        <MudTh Class="pa-2">
            <MudText Typo="Typo.subtitle1">@context.Key</MudText>
        </MudTh>
    </GroupHeaderTemplate>
    <HeaderContent>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudCard Class="mb-2" Elevation="1">
                <MudCardContent>
                    @if (_sortMode == TeacherQuoteSortMode.CreatedAtDesc)
                    {
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1">
                            @context.TeacherName
                        </MudText>
                    }
                    <MudText Typo="Typo.body1">„@context.Quote"</MudText>
                    @if (!string.IsNullOrWhiteSpace(context.Context))
                    {
                        <MudText Typo="Typo.body2" Class="mt-1" Color="Color.Secondary">@context.Context</MudText>
                    }
                </MudCardContent>
                <MudCardActions Class="pt-0">
                    <MudIconButton Icon="@(_likedQuoteIds.Contains(context.Id) ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                   Color="@(_likedQuoteIds.Contains(context.Id) ? Color.Error : Color.Default)"
                                   Size="Size.Small"
                                   Disabled="_busyQuoteIds.Contains(context.Id)"
                                   OnClick="@(() => ToggleLikeAsync(context.Id))" />
                    <MudText Typo="Typo.body2" Class="align-self-center">
                        @_likeCounts.GetValueOrDefault(context.Id)
                    </MudText>
                </MudCardActions>
            </MudCard>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Noch keine freigegebenen Zitate vorhanden.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
    </PagerContent>
</MudTable>

@code {
    private MudForm _form = null!;
    private MudTable<TeacherQuoteDto> _table = null!;
    private CandidateDto? _selectedTeacher;
    private readonly ZitatModel _model = new();
    private bool _sending;
    private bool _sentSuccessful;
    private Guid _studentId;
    private IReadOnlyList<CandidateDto> _teacherList = [];

    private Dictionary<Guid, int> _likeCounts = new();
    private HashSet<Guid> _likedQuoteIds = new();
    private readonly HashSet<Guid> _busyQuoteIds = new();

    private TeacherQuoteSortMode _sortMode = TeacherQuoteSortMode.Default;

    private readonly TableGroupDefinition<TeacherQuoteDto> _groups = new()
    {
        GroupName = "Lehrer",
        Indentation = false,
        Expandable = false,
        Selector = z => z.TeacherName
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        Guid.TryParse(idClaim, out _studentId);

        _teacherList = await TeacherQuoteService.GetTeacherAsync();
    }

    private Task<IEnumerable<CandidateDto>> SearchTeacherAsync(string value, CancellationToken cancellationToken)
    {
        IEnumerable<CandidateDto> result = string.IsNullOrWhiteSpace(value)
            ? _teacherList
            : _teacherList.Where(l => l.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private async Task SetSortModeAsync(TeacherQuoteSortMode mode)
    {
        if (_sortMode == mode)
        {
            return;
        }

        _sortMode = mode;
        await _table.ReloadServerData();
    }

    private async Task<TableData<TeacherQuoteDto>> ServerReloadAsync(TableState state, CancellationToken cancellationToken)
    {
        var page = await TeacherQuoteService.GetAcceptedQuotesAsync(state.Page, state.PageSize, _sortMode, cancellationToken);

        var idsOnPage = page.Quotes.Select(q => q.Id).ToArray();

        // Like-Zustände nur für die aktuell sichtbare Seite laden (kein N+1)
        var likedTask = _studentId != Guid.Empty
            ? LikeService.GetLikedQuoteIdsAsync(_studentId, idsOnPage, cancellationToken)
            : Task.FromResult<IReadOnlySet<Guid>>(new HashSet<Guid>());
        var countsTask = LikeService.GetLikeCountsAsync(idsOnPage, cancellationToken);

        await Task.WhenAll(likedTask, countsTask);

        _likedQuoteIds = likedTask.Result.ToHashSet();
        _likeCounts = countsTask.Result.ToDictionary(x => x.Key, x => x.Value);

        return new TableData<TeacherQuoteDto> { TotalItems = page.TotalCount, Items = page.Quotes };
    }

    private async Task ToggleLikeAsync(Guid quoteId)
    {
        if (_studentId == Guid.Empty)
        {
            Snackbar.Add("Liken ist nur für angemeldete Schüler möglich.", Severity.Warning);
            return;
        }

        if (!_busyQuoteIds.Add(quoteId))
        {
            return;
        }

        var wasLiked = _likedQuoteIds.Contains(quoteId);

        // Optimistisches Update
        if (wasLiked)
        {
            _likedQuoteIds.Remove(quoteId);
            _likeCounts[quoteId] = Math.Max(0, _likeCounts.GetValueOrDefault(quoteId) - 1);
        }
        else
        {
            _likedQuoteIds.Add(quoteId);
            _likeCounts[quoteId] = _likeCounts.GetValueOrDefault(quoteId) + 1;
        }

        StateHasChanged();

        try
        {
            var isLikedNow = await LikeService.ToggleLikeAsync(quoteId, _studentId);

            // Serverstand übernehmen, falls er vom optimistischen Update abweicht
            if (isLikedNow != !wasLiked)
            {
                if (isLikedNow) _likedQuoteIds.Add(quoteId); else _likedQuoteIds.Remove(quoteId);
                _likeCounts[quoteId] = await LikeService.GetLikeCountAsync(quoteId);
            }
        }
        catch
        {
            // Rollback bei Fehler
            if (wasLiked)
            {
                _likedQuoteIds.Add(quoteId);
                _likeCounts[quoteId] = _likeCounts.GetValueOrDefault(quoteId) + 1;
            }
            else
            {
                _likedQuoteIds.Remove(quoteId);
                _likeCounts[quoteId] = Math.Max(0, _likeCounts.GetValueOrDefault(quoteId) - 1);
            }

            Snackbar.Add("Like konnte nicht gespeichert werden.", Severity.Error);
        }
        finally
        {
            _busyQuoteIds.Remove(quoteId);
        }
    }

    private async Task SubmitAsync()
    {
        _sentSuccessful = false;
        await _form.ValidateAsync();

        if (!_form.IsValid || _selectedTeacher is null)
        {
            return;
        }

        _sending = true;
        try
        {
            await TeacherQuoteService.SubmitAsync(
                _selectedTeacher.Id,
                _model.Quote,
                _model.Context,
                _studentId == Guid.Empty ? null : _studentId);

            _sentSuccessful = true;
            _selectedTeacher = null;
            await _form.ResetAsync();
            await _table.ReloadServerData();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _sending = false;
        }
    }

    private sealed class ZitatModel
    {
        public string Quote { get; set; } = string.Empty;
        public string? Context { get; set; }
    }
}